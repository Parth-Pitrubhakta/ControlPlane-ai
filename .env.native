# Native (no Docker) development on the H200 box. Everything on loopback,
# non-default ports so we do not collide with other users of the machine.
MONGO_URI=mongodb://127.0.0.1:27817
MONGO_DB=controlplane
REDIS_URL=redis://127.0.0.1:6479/0
H200_HOST=127.0.0.1
VLLM_URL=http://127.0.0.1:8000/v1
DET_URL=http://127.0.0.1:8100
MOCK_H200=0
SHADOW_TOKENS=40
BATCH_WINDOW_MS=10
LOG_LEVEL=INFO
API_PORT=8080
